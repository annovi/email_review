# Email Review Secrets
# Copy this file to .secrets and fill in your credentials

# Anthropic API Key (get from console.anthropic.com)
CLAUDE_API_KEY=your-api-key-here

# Optional: model for the AI passes. Default is claude-opus-5-5.
# claude-haiku-4-5-20251001 is the cheap tier and is plenty for "is this sender a newsletter".
# CLAUDE_MODEL=claude-opus-5-5

# Email Credentials
EMAIL_ADDRESS=yourname@mac.com
APP_PASSWORD=your-app-specific-password
