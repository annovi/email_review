# Copy to .secrets.gmail and fill in. Used with:  ./venv/bin/python main.py scan --profile gmail
# Needs 2-Step Verification on the Google account and an App Password for Mail:
#   https://myaccount.google.com/apppasswords
EMAIL_ADDRESS=you@gmail.com
APP_PASSWORD=xxxx xxxx xxxx xxxx
# Optional overrides (defaults shown). CLAUDE_API_KEY is taken from .secrets if absent here.
# PROVIDER=gmail
# IMAP_HOST=imap.gmail.com
# SCAN_FOLDERS=[Gmail]/All Mail
# TRASH_FOLDER=[Gmail]/Trash
